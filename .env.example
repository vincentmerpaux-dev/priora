# Copier ce fichier en .env.local et renseigner les valeurs.
# Sans variables Supabase, Priora tourne en MODE DEMO (donnees fictives en memoire).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle secrete : serveur uniquement (formulaire public, webhook). Ne jamais la prefixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) ---
# Sans cle, l'analyse bascule sur un repli par regles.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Plafond d'analyses IA automatiques par organisation et par jour (controle du budget)
AI_DAILY_LIMIT_PER_ORG=50

# --- Application ---
# URL publique (snippet iframe, liens). En local : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- S3 : intégrations et notifications (tout est facultatif ; sans ces valeurs, la démo fonctionne) ---
# Clé de chiffrement des jetons d'intégration (HubSpot), mode Supabase uniquement. 32 octets en base64 :
#   openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
# Secret de la tâche planifiée /api/cron/speed-check (16 caractères minimum). Sans lui, la route reste fermée.
CRON_SECRET=
# Email des notifications de retard via Resend (offre gratuite). Sans clé : notifications dans l'application uniquement.
RESEND_API_KEY=
# Expéditeur (domaine vérifié chez Resend). Défaut : Priora <onboarding@resend.dev> (test, n'envoie qu'au propriétaire du compte).
RESEND_FROM=

# --- S4 : démo publique (Vercel gratuit, sans Supabase) ---
# Minimum pour mettre la démo en ligne : PRIORA_PUBLIC_DEMO=true (aucune clé requise).
# Active : bac à sable en mémoire par visiteur, enrichissement fictif, IA réelle / emails / webhook / email entrant / formulaire public désactivés, import CSV limité à 25 lignes, limitation de débit.
PRIORA_PUBLIC_DEMO=
# Durée d'inactivité avant effacement d'un bac à sable (minutes, défaut 120) et nombre maximal de bacs à sable gardés en mémoire (défaut 40).
PRIORA_DEMO_TTL_MINUTES=
PRIORA_DEMO_MAX_SESSIONS=
# true : désactive la visite guidée de la démo.
PRIORA_DISABLE_TOUR=
